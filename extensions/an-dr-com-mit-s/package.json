{
  "name": "an-dr-com-mit-s",
  "displayName": "an-dr: Commits (MIT)",
  "version": "3.0.0",
  "description": "%description%",
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "branch",
    "git",
    "git graph",
    "git history",
    "git log"
  ],
  "homepage": "https://github.com/an-dr/an-dr-vscode-extensions/tree/main/extensions/an-dr-com-mit-s",
  "bugs": {
    "url": "https://github.com/an-dr/an-dr-vscode-extensions/issues"
  },
  "license": "MIT",
  "author": "an-dr",
  "contributors": [
    {
      "name": "Michael Hutchison",
      "url": "https://github.com/mhutchie"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/an-dr/an-dr-vscode-extensions.git"
  },
  "publisher": "an-dr",
  "main": "./out/extension.js",
  "scripts": {
    "typecheck": "tsc -p ./src --noEmit && tsc -p ./src/webview --noEmit",
    "vscode:prepublish": "npm run package",
    "package": "npm run typecheck && node esbuild.js --production",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && node esbuild.js",
    "test": "vitest run --project backend && vitest run --project extension && vitest run --project webview",
    "test:ext": "npm run compile && npm run compile-tests && vscode-test",
    "compile-tests": "tsc -p tests-ext/tsconfig.json && tsc-alias -p tests-ext/tsconfig.json",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc -p ./src --noEmit --watch",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src && oxfmt ./l10n/bundle.l10n.json",
    "l10n:check": "npm run l10n:export && git diff --exit-code ./l10n/bundle.l10n.json && node scripts/check-l10n.js"
  },
  "dependencies": {
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~20.19.43",
    "@types/vscode": "~1.98.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.1",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "category": "an-dr: Commits (MIT)",
        "command": "an-dr-com-mit-s.view",
        "title": "%command.view%",
        "icon": {
          "light": "resources/webview-icon-light.svg",
          "dark": "resources/webview-icon-dark.svg"
        }
      },
      {
        "category": "an-dr: Commits (MIT)",
        "command": "an-dr-com-mit-s.addGitRepository",
        "title": "%command.addGitRepository%"
      },
      {
        "category": "an-dr: Commits (MIT)",
        "command": "an-dr-com-mit-s.clearAvatarCache",
        "title": "%command.clearAvatarCache%"
      },
      {
        "category": "an-dr: Commits (MIT)",
        "command": "an-dr-com-mit-s.fetch",
        "title": "%command.fetch%"
      },
      {
        "category": "an-dr: Commits (MIT)",
        "command": "an-dr-com-mit-s.pull",
        "title": "%command.pull%"
      },
      {
        "category": "an-dr: Commits (MIT)",
        "command": "an-dr-com-mit-s.push",
        "title": "%command.push%"
      },
      {
        "category": "an-dr: Commits (MIT)",
        "command": "an-dr-com-mit-s.removeGitRepository",
        "title": "%command.removeGitRepository%"
      },
      {
        "category": "an-dr: Commits (MIT)",
        "command": "an-dr-com-mit-s.version",
        "title": "%command.version%"
      },
      {
        "category": "an-dr: Commits (MIT)",
        "command": "an-dr-com-mit-s.openFile",
        "title": "%command.openFile%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "an-dr-com-mit-s.view",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "an-dr: Commits (MIT)",
      "properties": {
        "an-dr-com-mit-s.autoCenterCommitDetailsView": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoCenterCommitDetailsView%"
        },
        "an-dr-com-mit-s.repository.commits.committedVisual": {
          "type": "string",
          "enum": [
            "Avatar",
            "Initials"
          ],
          "enumDescriptions": [
            "Render a visual avatar next to committed date/time.",
            "Render deterministic 2-letter initials next to committed date/time."
          ],
          "default": "Avatar",
          "description": "Controls the visual shown in the Committed column."
        },
        "an-dr-com-mit-s.repository.commits.avatar.mode": {
          "type": "string",
          "enum": [
            "Auto (Fetched then Pattern)",
            "Fetched Only",
            "Procedural Pattern",
            "Disabled"
          ],
          "enumDescriptions": [
            "Show fetched avatars when available, otherwise show deterministic procedural patterns.",
            "Show only fetched avatars (no fallback visual).",
            "Always show deterministic procedural patterns.",
            "Don't show any author visual."
          ],
          "default": "Auto (Fetched then Pattern)",
          "description": "Controls how author visuals are rendered in the Committed column and Commit Details."
        },
        "an-dr-com-mit-s.repository.commits.avatar.size": {
          "type": "string",
          "enum": [
            "Normal",
            "Small"
          ],
          "default": "Normal",
          "description": "Controls avatar size in the Committed column."
        },
        "an-dr-com-mit-s.repository.commits.avatar.shape": {
          "type": "string",
          "enum": [
            "Circle",
            "Square"
          ],
          "default": "Circle",
          "description": "Controls the shape of author visuals in the Committed column and Commit Details."
        },
        "an-dr-com-mit-s.dateFormat": {
          "type": "string",
          "enum": [
            "Date & Time",
            "Date Only",
            "Relative"
          ],
          "enumDescriptions": [
            "%config.dateFormat.dateTime%",
            "%config.dateFormat.dateOnly%",
            "%config.dateFormat.relative%"
          ],
          "default": "Date & Time",
          "description": "%config.dateFormat%"
        },
        "an-dr-com-mit-s.dateType": {
          "type": "string",
          "enum": [
            "Author Date",
            "Commit Date"
          ],
          "enumDescriptions": [
            "%config.dateType.authorDate%",
            "%config.dateType.commitDate%"
          ],
          "default": "Author Date",
          "description": "%config.dateType%"
        },
        "an-dr-com-mit-s.fetchAvatars": {
          "type": "boolean",
          "default": false,
          "description": "%config.fetchAvatars%"
        },
        "an-dr-com-mit-s.graphColours": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "%config.graphColours.item%",
            "pattern": "^\\s*(#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|rgb[a]?\\s*\\(\\d{1,3},\\s*\\d{1,3},\\s*\\d{1,3}\\))\\s*$"
          },
          "default": [
            "#0085d9",
            "#d9008f",
            "#00d90a",
            "#d98500",
            "#a300d9",
            "#ff0000",
            "#00d9cc",
            "#e138e8",
            "#85d900",
            "#dc5b23",
            "#6f24d6",
            "#ffcc00"
          ],
          "description": "%config.graphColours%"
        },
        "an-dr-com-mit-s.graphStyle": {
          "type": "string",
          "enum": [
            "rounded",
            "angular"
          ],
          "enumDescriptions": [
            "%config.graphStyle.rounded%",
            "%config.graphStyle.angular%"
          ],
          "default": "rounded",
          "description": "%config.graphStyle%"
        },
        "an-dr-com-mit-s.initialLoadCommits": {
          "type": "number",
          "default": 300,
          "description": "%config.initialLoadCommits%"
        },
        "an-dr-com-mit-s.loadMoreCommits": {
          "type": "number",
          "default": 100,
          "description": "%config.loadMoreCommits%"
        },
        "an-dr-com-mit-s.maxDepthOfRepoSearch": {
          "type": "number",
          "default": 0,
          "description": "%config.maxDepthOfRepoSearch%"
        },
        "an-dr-com-mit-s.showCurrentBranchByDefault": {
          "type": "boolean",
          "default": false,
          "description": "%config.showCurrentBranchByDefault%"
        },
        "an-dr-com-mit-s.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "%config.showStatusBarItem%"
        },
        "an-dr-com-mit-s.statusBarIconOnly": {
          "type": "boolean",
          "default": true,
          "description": "Show only the status bar icon, without the extension name."
        },
        "an-dr-com-mit-s.showUncommittedChanges": {
          "type": "boolean",
          "default": true,
          "description": "%config.showUncommittedChanges%"
        },
        "an-dr-com-mit-s.tabIconColourTheme": {
          "type": "string",
          "enum": [
            "colour",
            "grey"
          ],
          "enumDescriptions": [
            "%config.tabIconColourTheme.colour%",
            "%config.tabIconColourTheme.grey%"
          ],
          "default": "colour",
          "description": "%config.tabIconColourTheme%"
        },
        "an-dr-com-mit-s.blame.inlineMessageEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Show blame information inline next to the active line."
        },
        "an-dr-com-mit-s.inlineBlame.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Deprecated compatibility alias for an-dr-com-mit-s.blame.inlineMessageEnabled."
        },
        "an-dr-com-mit-s.blame.inlineMessageFormat": {
          "type": "string",
          "default": "Blame ${author.name} (${time.ago})",
          "description": "Customize the inline blame message. Supports ${author.name}, ${author.mail}, ${commit.hash}, ${commit.hash_short}, ${commit.summary} and ${time.ago}."
        },
        "an-dr-com-mit-s.blame.inlineMessageNoCommit": {
          "type": "string",
          "default": "Not Committed Yet",
          "description": "Customize the inline blame message for uncommitted lines."
        },
        "an-dr-com-mit-s.blame.inlineMessageMargin": {
          "type": "number",
          "default": 2,
          "description": "The amount of margin, in rem, between the line and the inline blame message."
        },
        "an-dr-com-mit-s.blame.currentUserAlias": {
          "type": "string",
          "default": "",
          "description": "Alias shown instead of your own name in blame messages. Empty disables the alias."
        },
        "an-dr-com-mit-s.blame.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Ignore whitespace changes when blaming (the -w flag)."
        },
        "an-dr-com-mit-s.blame.delayBlame": {
          "type": "number",
          "default": 0,
          "description": "Delay in milliseconds before inline blame is displayed."
        },
        "an-dr-com-mit-s.blame.maxLineCount": {
          "type": "number",
          "default": 16384,
          "description": "Skip blame for files with more lines than this value."
        },
        "an-dr-com-mit-s.blame.extendedHoverInformation": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "inline-status",
            "inline",
            "status"
          ],
          "description": "Where to show extended blame information on hover."
        },
        "an-dr-com-mit-s.blame.detectMoveOrCopyFromOtherFiles": {
          "type": "number",
          "default": 0,
          "enum": [
            0,
            1,
            2,
            3
          ],
          "description": "How aggressively to detect lines moved or copied from other files. Each level adds a -C flag."
        },
        "an-dr-com-mit-s.logLevel": {
          "type": "string",
          "default": "Info",
          "enum": [
            "Debug",
            "Info",
            "Warning",
            "Error"
          ],
          "description": "Lowest severity written to the extension output channel."
        },
        "an-dr-com-mit-s.statusBarItem.dirtyIndicator": {
          "type": "string",
          "default": "+N -M",
          "enum": [
            "+N -M",
            "*",
            "none"
          ],
          "enumDescriptions": [
            "Show counts of modified and deleted files.",
            "Show a single asterisk when the working tree is dirty.",
            "Show no indicator."
          ],
          "description": "How the working-tree state is indicated in the status bar."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.98.0"
  },
  "packageManager": "npm@11.6.2"
}
